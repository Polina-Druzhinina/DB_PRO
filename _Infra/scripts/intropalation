do
$do$
begin
    drop function if exists interpolate(numeric, interpolation) cascade;
    drop function if exists get_interpolation_bounds(numeric) cascade;

    create or replace function get_interpolation_bounds(p_temp numeric)
    returns public.interpolation as
    $func$
    declare
        var_interpolation public.interpolation;
    begin
        -- Нижняя граница
        SELECT INTO var_interpolation.x0, var_interpolation.y0
            COALESCE(
                (SELECT COALESCE(t0_min, t0_max) FROM public.temperature_corrections WHERE COALESCE(t0_min, t0_max) <= p_temp ORDER BY COALESCE(t0_min, t0_max) DESC LIMIT 1),
                (SELECT MIN(COALESCE(t0_min, t0_max)) FROM public.temperature_corrections)
            ),
            COALESCE(
                (SELECT delta_tv FROM public.temperature_corrections WHERE COALESCE(t0_min, t0_max) <= p_temp ORDER BY COALESCE(t0_min, t0_max) DESC LIMIT 1),
                (SELECT delta_tv FROM public.temperature_corrections ORDER BY delta_tv ASC LIMIT 1)
            );

        -- Верхняя граница
        SELECT INTO var_interpolation.x1, var_interpolation.y1
            COALESCE(
                (SELECT COALESCE(t0_max, t0_min) FROM public.temperature_corrections WHERE COALESCE(t0_max, t0_min) >= p_temp ORDER BY COALESCE(t0_max, t0_min) ASC LIMIT 1),
                (SELECT MAX(COALESCE(t0_max, t0_min)) FROM public.temperature_corrections)
            ),
            COALESCE(
                (SELECT delta_tv FROM public.temperature_corrections WHERE COALESCE(t0_max, t0_min) >= p_temp ORDER BY COALESCE(t0_max, t0_min) ASC LIMIT 1),
                (SELECT delta_tv FROM public.temperature_corrections ORDER BY delta_tv DESC LIMIT 1)
            );

        if var_interpolation.x0 = var_interpolation.x1 then
            var_interpolation.y0 := var_interpolation.y1;
        end if;

        return var_interpolation;
    end;
    $func$
    language plpgsql;

    create or replace function interpolate(x numeric, points public.interpolation)
    returns numeric as
    $func2$
    begin
        if points.x1 = points.x0 or (points.x1 - points.x0) = 0 then
            return points.y0;
        end if;

        return points.y0 + (points.y1 - points.y0) * (x - points.x0) / (points.x1 - points.x0);
    end;
    $func2$
    language plpgsql;

end
$do$;