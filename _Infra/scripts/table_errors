-- задание 1

--таблица с ошибками
drop table if exists parameter_error;
drop sequence if exists parameters_erroe_id_seq;
create sequence parameters_erroe_id_seq;
create table parameter_error(
	id integer primary key default nextval('parameters_erroe_id_seq'),
	id_parameter integer not null,
	description text not null
);
comment on table parameter_error is 'Справочник ошибок в параметрах';
comment on column parameter_error.id is 'Уникальный идентификатор ошибки';
comment on column parameter_error.id_parameter is 'Идентификатор параметра';
comment on column parameter_error.description is 'Описание ошибки';
alter table parameter_error add constraint fk_parameter_error_parameter foreign key (id_parameter) references parameters(id);

-- Type: lst_parameter

-- DROP TYPE IF EXISTS public.lst_parameter;

CREATE TYPE public.lst_parameter AS
(
	id_type_parameter integer,
	param_value numeric
);

ALTER TYPE public.lst_parameter
    OWNER TO postgres;

-- функция
do
$do$
begin
	drop function if exists public.check_parameters(public.lst_parameter[]);
	
	create or replace function public.check_parameters(
	    p_parameters public.lst_parameter[]
	)
	returns table (
	    error_count integer,
	    error_description text
	) as
	$func$
	declare
	    var_parameter public.lst_parameter;
	    var_min numeric;
	    var_max numeric;
	    var_name text;
	    var_error_count integer := 0;
	    var_errors text := '';
	begin
	    foreach var_parameter in array p_parameters
	    loop
	        select tp.name, tp.min_value, tp.max_value
	        into var_name, var_min, var_max
	        from public.type_parameters tp
	        where tp.id = var_parameter.id_type_parameter;
	
	        if not found then
	            var_error_count := var_error_count + 1;
	            var_errors := var_errors || 'Неизвестный параметр; ';
	
	        elsif var_min is not null
	              and var_parameter.param_value < var_min then
	            var_error_count := var_error_count + 1;
	            var_errors := var_errors || var_name ||
	                ': значение меньше допустимого минимума; ';
	
	        elsif var_max is not null
	              and var_parameter.param_value > var_max then
	            var_error_count := var_error_count + 1;
	            var_errors := var_errors || var_name ||
	                ': значение больше допустимого максимума; ';
	        end if;
	    end loop;
	
	    if var_error_count = 0 then
	        var_errors := 'Ошибок нет';
	    end if;
	
	    error_count := var_error_count;
	    error_description := var_errors;
	
	    return next;
	end;
	$func$
	language plpgsql;
end
$do$;

-- добавила данные с ошибкой
insert into packs (created_at, id_user, id_equipment_type)
values (current_timestamp, 1, 1);
insert into parameters (id_pack, id_type_parameter, param_value)
values
    (currval('packs_id_seq'), 1, 100),
    (currval('packs_id_seq'), 2, 70),
    (currval('packs_id_seq'), 3, 760),
    (currval('packs_id_seq'), 4, 30),
    (currval('packs_id_seq'), 5, 10);

