-- select
select
    p.id_pack,
    p.name_pack,
    p.created_at,
    u.full_name,
    pos.name_position,
    te.name_equipment_type,
    par.id_parameter,
    par.name_parameter,
    p.param_value
from packs as p
join users as u
    on p.id_user = u.id_user
join positions as pos
    on u.id_position = pos.id_position
join type_equipment as te
    on p.id_equipment_type = te.id_equipment_type
join parameters as par
    on p.id_parameter = par.id_parameter;