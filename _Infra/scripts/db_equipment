drop table packs;
drop table users;
drop table parameters;
drop table positions;
drop table type_equipment;

-- ddl type_equipment
create table type_equipment(
    id_equipment_type integer primary key,
    name_equipment_type varchar(50) not null 
);
comment on table type_equipment is 'Справочник типов оборудования';
comment on column type_equipment.id_equipment_type is 'Уникальный идентификатор типа оборудования';
comment on column type_equipment.name_equipment_type is 'Название типа оборудования';

-- ddl positions
create table positions(
    id_position integer primary key,
    name_position varchar(100) not null
);
comment on table positions is 'Справочник должностей пользователей';
comment on column positions.id_position is 'Уникальный код должности';
comment on column positions.name_position is 'Название должности';

-- ddl parameters
create table parameters (
    id_parameter integer primary key,
    name_parameter varchar(255) not null,
	id_packs integer not null,
	param_value numeric not null
);
comment on table parameters is 'Параметры измерений, входящие в состав пачек';
comment on column parameters.id_parameter is 'Уникальный идентификатор параметра';
comment on column parameters.name_parameter is 'Название параметра (температура, давление и т.д.)';
comment on column parameters.id_packs is 'Код пачки, к которой принадлежит параметр';
comment on column parameters.param_value is 'Числовое значение параметра';

-- ddl users
create table users (
    id_user integer primary key,
    login varchar(50) not null,
    password varchar(50) not null,
    full_name varchar(255) not null,
    id_position integer not null
);
comment on table users is 'Пользователи системы';
comment on column users.id_user is 'Уникальный идентификатор пользователя';
comment on column users.login is 'Логин для входа в систему';
comment on column users.password is 'Пароль пользователя';
comment on column users.full_name is 'ФИО пользователя';
comment on column users.id_position is 'Код должности пользователя';

-- ddl packs
create table packs(
    id_pack integer primary key,
    name_pack varchar(255) not null,
    created_at timestamp not null,
    id_user integer not null,
	id_position integer not null,
    id_equipment_type integer not null
);
comment on table packs is 'Пачки измерений - наборы параметров для оборудования';
comment on column packs.id_pack is 'Уникальный код пачки';
comment on column packs.name_pack is 'Название пачки';
comment on column packs.created_at is 'Дата и время создания';
comment on column packs.id_user is 'Код пользователя, создавшего пачку';
comment on column packs.id_position is 'Код должности пользователя';
comment on column packs.id_equipment_type is 'Код типа оборудования';

