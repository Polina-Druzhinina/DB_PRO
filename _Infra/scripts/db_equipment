drop table packs;
drop table users;
drop table parameters;
drop table positions;
drop table type_equipment;

-- ddl type_equipment
create table type_equipment(
    id_equipment_type integer primary key,
    name_equipment_type varchar(255) not null
);

-- ddl positions
create table positions(
    id_position integer primary key,
    name_position varchar(255) not null
);

-- ddl parameters
create table parameters (
    id_parameter integer primary key,
    name_parameter varchar(255) not null,
    unit varchar(20),
    min_value numeric,
    max_value numeric,
    default_value numeric,
    id_equipment_type integer,
    foreign key (id_equipment_type) references type_equipment(id_equipment_type)
);

-- ddl users
create table users (
    id_user integer primary key,
    login varchar(50) not null unique,
    password varchar(255) not null,
    full_name varchar(255) not null,
    id_position integer not null,
    foreign key (id_position) references positions(id_position)
);

-- ddl packs
create table packs (
    id_pack integer primary key,
    name_pack varchar(255) not null,
    created_at timestamp not null,
    id_user integer not null,
    id_equipment_type integer not null,

    input_height integer,
    input_temperature numeric(4,1),
    input_pressure integer,
    input_wind_direction integer,
    input_wind_speed integer,
    input_bullet_range integer,

    result_h integer,
    result_tt numeric(4,1),
    result_hh integer,
    result_cc numeric(4,1),
    foreign key (id_user) references users(id_user),
    foreign key (id_equipment_type) references type_equipment(id_equipment_type)
);

