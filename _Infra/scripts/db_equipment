-- select
select
    p.id_pack,
    p.name_pack,
    p.created_at,
    u.full_name,
    pos.name_position,
    te.name_equipment_type,
    par.id_parameter,
    par.name_parameter,
    par.param_value
from packs as p,
     users as u,
     positions as pos,
     type_equipment as te,
     parameters as par
where p.id_user = u.id_user
  and u.id_position = pos.id_position
  and p.id_equipment_type = te.id_equipment_type
  and p.id_pack = par.id_packs
order by p.id_pack, par.id_parameter;
