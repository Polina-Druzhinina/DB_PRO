-- select 
select
    p.id_pack,
    p.name_pack,
    p.created_at,
    u.login,
    u.full_name,
    pos.name_position,
    te.name_equipment_type,
    p.input_height,
    p.input_temperature,
    p.input_pressure,
    p.result_h,
    p.result_tt,
    p.result_hh,
    p.result_cc,
    par.name_parameter,
    par.unit,
    par.min_value,
    par.max_value,
    par.default_value
from packs p
join users u on p.id_user = u.id_user
join positions pos on u.id_position = pos.id_position
join type_equipment te on p.id_equipment_type = te.id_equipment_type
join parameters par on par.id_equipment_type is null or par.id_equipment_type = p.id_equipment_type
order by p.id_pack, par.id_parameter;