begin;

do $$
begin

insert into packs (created_at, id_user, id_equipment_type) values
(current_timestamp, 1, 1);

insert into parameters (id_pack, id_type_parameter, param_value) values
(currval('packs_id_seq'), 1, 33),
(currval('packs_id_seq'), 2, 20),
(currval('packs_id_seq'), 3, 950),
(currval('packs_id_seq'), 4, 75),
(currval('packs_id_seq'), 5, 12);


insert into packs (created_at, id_user, id_equipment_type) values
(current_timestamp, 3, 2);

insert into parameters (id_pack, id_type_parameter, param_value) values
(currval('packs_id_seq'), 1, 55),
(currval('packs_id_seq'), 2, -70),
(currval('packs_id_seq'), 3, 450),
(currval('packs_id_seq'), 4, 30),
(currval('packs_id_seq'), 6, 200);


insert into packs (created_at, id_user, id_equipment_type) values
(current_timestamp, 1, 1);

insert into parameters (id_pack, id_type_parameter, param_value) values
(currval('packs_id_seq'), 1, 33),
(currval('packs_id_seq'), 2, 20),
(currval('packs_id_seq'), 3, 950),
(currval('packs_id_seq'), 4, 75),
(currval('packs_id_seq'), 5, 12);

end $$;


-- список параметров с ошибками
select
    p.id as "№",
    te.short_name as "тип оборудования",
    max(case when prm.id_type_parameter = 1 then prm.param_value end) as "высота метеопоста",
    max(case when prm.id_type_parameter = 2 then prm.param_value end) as "температура",
    max(case when prm.id_type_parameter = 3 then prm.param_value end) as "давление",
    max(case when prm.id_type_parameter = 4 then prm.param_value end) as "направление ветра",
    max(case when prm.id_type_parameter = 5 then prm.param_value end) as "скорость ветра",
    max(case when prm.id_type_parameter = 6 then prm.param_value end) as "дальность сноса пуль",
    err.has_error as "флаг: есть ошибка",
    err.error_text as "описание ошибки"
from packs as p
    join type_equipment as te on te.id = p.id_equipment_type
    left join parameters as prm on prm.id_pack = p.id
    cross join public.check_parameters(public.get_lst_parameter(p.id)) as err
group by p.id, te.short_name, err.has_error, err.error_text
order by p.id;


-- лучший стрелок
select
    u.full_name as "пользователь",
    sum(err.error_num) as "количество ошибок"
from packs as p
    join users as u on p.id_user = u.id
    cross join public.check_parameters(public.get_lst_parameter(p.id)) as err
group by u.id, u.full_name
order by sum(err.error_num);