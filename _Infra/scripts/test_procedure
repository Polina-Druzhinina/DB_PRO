--тест
insert into packs (created_at, id_user, id_equipment_type)
values ('2026-09-24 09:30:00', 1, 1);

insert into parameters (id_pack, id_type_parameter, param_value)
values
    (currval('packs_id_seq'), 1, 100),
    (currval('packs_id_seq'), 2, 3),
    (currval('packs_id_seq'), 3, 757),
    (currval('packs_id_seq'), 4, 30),
    (currval('packs_id_seq'), 5, 8);

call public.calculate_meteo_bulletin_proc(
    public.get_lst_parameter(currval('packs_id_seq')::integer),
    1
);
select * from tmp_bulletin;

