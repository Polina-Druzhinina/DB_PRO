-- 6 пункт
drop table if exists meteorological_constants;

create table meteorological_constants (
    name text primary key,
    value numeric not null
);

insert into meteorological_constants (name, value)
values
    ('pressure', 750),
    ('temperature', 15.9);


create or replace function public.get_constant(p_name text)
returns numeric
language plpgsql
as $body$
declare
    var_value numeric;
begin
    select value into var_value
    from public.meteorological_constants
    where name = p_name;

    if not found then
        raise exception 'константа не найдена';
    end if;

    return var_value;
end;
$body$;


create or replace function public.get_date()
returns text
language plpgsql
as $body$
begin
    return to_char(current_timestamp, 'DDHH')
        || floor(extract(minute from current_timestamp) / 10)::integer;
end;
$body$;


select
    public.get_date(),
    public.calculate_vvvv(60),
    public.calculate_bbbtt(765, 25);