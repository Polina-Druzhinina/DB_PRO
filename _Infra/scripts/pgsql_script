-- шаг 3: создание связей и ограничений
do $$ 
begin
    -- связи между таблицами (foreign key)
    alter table units add constraint fk_units_base foreign key (id_base_unit) references base_units(id);
    alter table users add constraint fk_users_position foreign key (id_position) references positions(id);
    alter table type_parameters add constraint fk_type_params_unit foreign key (id_unit) references units(id);
    alter table packs add constraint fk_packs_user foreign key (id_user) references users(id);
    alter table packs add constraint fk_packs_equipment foreign key (id_equipment_type) references type_equipment(id);
    alter table parameters add constraint fk_parameters_pack foreign key (id_pack) references packs(id);
    alter table parameters add constraint fk_parameters_type foreign key (id_type_parameter) references type_parameters(id);

    -- простые ограничения (check)
    alter table units add constraint chk_conversion_factor check (conversion_factor > 0);
    alter table type_parameters add constraint chk_min_max check (min_value is null or max_value is null or min_value < max_value);
end $$;