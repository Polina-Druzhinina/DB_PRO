-- шаг 1: создание структуры таблиц и счетчиков
do $$ 
begin
    -- удаление 
    drop table if exists parameters cascade;
    drop table if exists packs cascade;
    drop table if exists type_parameters cascade;
    drop table if exists users cascade;
    drop table if exists units cascade;
    drop table if exists type_equipment cascade;
    drop table if exists positions cascade;
    drop table if exists base_units cascade;

    drop sequence if exists parameters_id_seq;
    drop sequence if exists packs_id_seq;
    drop sequence if exists type_parameters_id_seq;
    drop sequence if exists users_id_seq;
    drop sequence if exists units_id_seq;
    drop sequence if exists type_equipment_id_seq;
    drop sequence if exists positions_id_seq;
    drop sequence if exists base_units_id_seq;

    -- создание счетчиков
    create sequence base_units_id_seq;
    create sequence positions_id_seq;
    create sequence type_equipment_id_seq;
    create sequence units_id_seq;
    create sequence users_id_seq;
    create sequence type_parameters_id_seq;
    create sequence packs_id_seq;
    create sequence parameters_id_seq;

    -- инициализация таблиц
    create table base_units (
        id integer primary key default nextval('base_units_id_seq'),
        name varchar(100) not null,
        symbol varchar(15) not null
    );

    create table positions (
        id integer primary key default nextval('positions_id_seq'),
        name varchar(100) not null
    );

    create table type_equipment (
        id integer primary key default nextval('type_equipment_id_seq'),
        short_name varchar(15) not null,
        description varchar(255) not null
    );

    create table units (
        id integer primary key default nextval('units_id_seq'),
        name varchar(100) not null,
        symbol varchar(15) not null,
        conversion_factor decimal(18,6) not null,
        id_base_unit integer not null
    );

    create table users (
        id integer primary key default nextval('users_id_seq'),
        full_name varchar(255) not null,
        id_position integer not null,
        birthday timestamp
    );

    create table type_parameters (
        id integer primary key default nextval('type_parameters_id_seq'),
        name varchar(100) not null,
        id_unit integer not null,
        min_value numeric,
        max_value numeric 
    );

    create table packs (
        id integer primary key default nextval('packs_id_seq'),
        created_at timestamp not null,
        id_user integer not null,
        id_equipment_type integer not null
    );

    create table parameters (
        id integer primary key default nextval('parameters_id_seq'),
        id_pack integer not null,
        id_type_parameter integer not null,
        param_value numeric not null
    );

    create table temperature_corrections (
        id integer primary key default nextval('temperature_corrections_id_seq'),
        t0_min numeric,
        t0_max numeric,
        delta_tv numeric not null
    );
end $$;

